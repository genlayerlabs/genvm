[
  {
    "type": "enum",
    "name": "result_code",
    "repr": "u8",
    "values": {
      "return": 0,
      "user_error": 1,
      "vm_error": 2,
      "internal_error": 3
    }
  },
  {
    "type": "enum",
    "name": "storage_type",
    "repr": "u8",
    "values": {
      "default": 0,
      "latest_final": 1,
      "latest_non_final": 2
    }
  },
  {
    "type": "enum",
    "name": "entry_kind",
    "repr": "u8",
    "values": {
      "main": 0,
      "sandbox": 1,
      "consensus_stage": 2
    }
  },
  {
    "type": "consts",
    "name": "memory_limiter_consts",
    "repr": "u32",
    "values": {
      "table_entry": 64,
      "file_mapping": 256,
      "fd_allocation": 96
    }
  },
  {
    "type": "consts",
    "name": "top_limits",
    "repr": "u32",
    "values": {
      "nondet_blocks": 4096,
      "locked_slots": 256,
      "upgraders": 32,
      "vm_recursion": 512,
      "web_request_min_space": 65536,
      "web_render_min_space": 134217728
    }
  },
  {
    "type": "enum",
    "name": "special_method",
    "repr": "str",
    "values": {
      "get_schema": "#get-schema",
      "errored_message": "#error"
    }
  },
  {
    "type": "str_trie",
    "name": "vm_error",
    "values": [
      "timeout",
      "absent_leader_nondet_output",
      {
        "head": "exit_code",
        "tail": "$i32"
      },
      {
        "head": "wasm_trap",
        "tail": "$str"
      },
      {
        "head": "OOM",
        "tail": [
          {
            "head": "RAM",
            "tail": [
              [], "table", "memory", "limit"
            ]
          },
          "storage",
          "receipt"
        ]
      },
      {
        "head": "invalid_contract",
        "tail": [
          null,
          "absent_runner_comment",
          "not_utf8_text",
          "malformed_runner",
          {
            "head": "wasm",
            "tail": ["validating", "linking", "entrypoint"]
          }
        ]
      },
      {
        "head": "host",
        "tail": "$str"
      }
    ]
  },
  {
    "type": "const",
    "name": "event_max_topics",
    "repr": "u32",
    "value": 4
  },
  {
    "type": "const",
    "name": "absent_version",
    "repr": "str",
    "value": "v0.1.0"
  },
  {
    "type": "const",
    "name": "code_slot_offset",
    "repr": "u32",
    "value": 1
  }
]
