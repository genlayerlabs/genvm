From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: kp2pml30 <kp2pml30@gmail.com>
Date: Thu, 12 Mar 2026 22:42:19 +0900
Subject: [PATCH] add proper error for unexported memory

---
 crates/wiggle/generate/src/wasmtime.rs | 2 +-
 crates/wiggle/src/error.rs             | 2 ++
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/crates/wiggle/generate/src/wasmtime.rs b/crates/wiggle/generate/src/wasmtime.rs
index cfa0f037..ae980400 100644
--- a/crates/wiggle/generate/src/wasmtime.rs
+++ b/crates/wiggle/generate/src/wasmtime.rs
@@ -165,7 +165,7 @@ fn generate_func(
                 let ctx = #get_cx(caller.data_mut());
                 (wiggle::GuestMemory::Shared(m.data()), ctx)
             }
-            _ => wiggle::anyhow::bail!("missing required memory export"),
+            _ => return Err(wiggle::GuestError::MemoryNotExported.into()),
         };
         Ok(<#ret_ty>::from(#abi_func(#cx_ref ctx, &mut mem #(, #arg_names)*) #await_ ?))
     };
diff --git a/crates/wiggle/src/error.rs b/crates/wiggle/src/error.rs
index e8dd0f5a..04f199bc 100644
--- a/crates/wiggle/src/error.rs
+++ b/crates/wiggle/src/error.rs
@@ -31,4 +31,6 @@ pub enum GuestError {
     InvalidUtf8(#[from] ::std::str::Utf8Error),
     #[error("Int conversion error: {0:?}")]
     TryFromIntError(#[from] ::std::num::TryFromIntError),
+    #[error("Memory not exported")]
+    MemoryNotExported,
 }
